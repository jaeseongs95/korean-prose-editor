{
  "name": "korean-prose-editor",
  "version": "0.1.0",
  "description": "Conservative Korean prose editing skill with deterministic preservation checks and finalization.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "test": "node --test",
    "validate": "node scripts/validate-repository.mjs",
    "eval:diagnostic:prepare": "node scripts/prepare-known-diagnostic.mjs",
    "eval:regressions:extract": "node scripts/extract-semantic-drift-regressions.mjs",
    "eval:regressions:prepare": "node scripts/prepare-semantic-regression.mjs",
    "eval:regressions:migrate": "node scripts/prepare-historical-regression-work-products.mjs",
    "eval:regressions:aggregate": "node scripts/aggregate-semantic-regression.mjs",
    "eval:verification:contrast:prepare": "node scripts/prepare-verification-minimal-contrast.mjs",
    "eval:regressions:new-candidates:prepare": "node scripts/prepare-new-semantic-candidates.mjs",
    "eval:units": "node scripts/prepare-source-unit-manifests.mjs",
    "eval:selection:record": "node scripts/record-selection-run.mjs",
    "eval:editing:record": "node scripts/record-editing-run.mjs",
    "eval:diagnostic:aggregate": "node scripts/aggregate-selection-diagnostic.mjs",
    "eval:selection:contrast:aggregate": "node scripts/aggregate-selection-taxonomy-contrast.mjs",
    "eval:cycle:prepare": "node scripts/prepare-evaluation-cycle.mjs",
    "eval:cycle:aggregate": "node scripts/aggregate-evaluation-cycle.mjs",
    "eval:cycle:summarize": "node scripts/summarize-evaluation-cycle.mjs"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@eslint/js": "9.35.0",
    "ajv": "8.17.1",
    "eslint": "9.35.0",
    "globals": "16.3.0",
    "typescript": "5.9.2"
  }
}
