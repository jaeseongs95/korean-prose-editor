{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/korean-prose-editor/evaluation/run-meta.schema.json",
  "title": "Evaluation role work-product metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "run", "role", "actorId", "caseCount", "inputSha256", "workProductSha256", "status"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "run": { "type": "integer", "minimum": 1, "maximum": 3 },
    "role": { "enum": ["selection", "editing", "verification"] },
    "actorId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "inputSha256": { "$ref": "#/$defs/digest" },
    "workProductSha256": { "$ref": "#/$defs/digest" },
    "status": { "const": "complete" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
