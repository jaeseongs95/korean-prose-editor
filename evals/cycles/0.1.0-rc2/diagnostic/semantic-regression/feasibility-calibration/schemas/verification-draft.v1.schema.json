{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/korean-prose-editor/feasibility/verification-draft.v1.schema.json",
  "title": "Feasibility calibration verifier draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "calibrationId", "actorId", "caseId", "canonicalCandidateDigest", "candidateDigest", "independentValidity", "safetyFailure", "decision", "reasonCode", "sourceDefect", "invariantDelta"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "calibrationId": { "type": "string", "minLength": 1 },
    "actorId": { "$ref": "#/$defs/actorId" },
    "caseId": { "type": "string", "minLength": 1 },
    "canonicalCandidateDigest": { "$ref": "#/$defs/digest" },
    "candidateDigest": { "$ref": "#/$defs/digest" },
    "independentValidity": { "enum": ["pass", "fail", "uncertain"] },
    "safetyFailure": { "type": "boolean" },
    "decision": { "enum": ["accept", "retain", "confirm-infeasible", "dispute-infeasible"] },
    "reasonCode": { "enum": ["MEANING_PRESERVED", "NO_CLEAR_IMPROVEMENT", "SOURCE_DEFECT_NOT_ESTABLISHED", "MEANING_CHANGED", "PROTECTED_STRING_CHANGED", "REGISTER_CHANGED", "INFEASIBLE_CONFIRMED", "SAFE_EDIT_EXISTS", "UNCERTAIN"] },
    "sourceDefect": { "$ref": "#/$defs/sourceDefect" },
    "invariantDelta": { "$ref": "#/$defs/invariantDelta" }
  },
  "$defs": {
    "actorId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceDefect": { "enum": ["GRAMMATICAL_MISMATCH", "NOUN_STACKING", "REDUNDANCY", "TRANSLATIONESE", "UNNECESSARY_META_PROSE", "UNSUPPORTED_EMPHASIS", "USER_FACING_IMPLEMENTATION_JARGON", "NONE"] },
    "invariantDelta": { "enum": ["NONE", "QUANTIFIER_SCOPE", "CONDITION_OR_TENSE", "MODALITY_OR_CERTAINTY", "ACTION_OR_AUTHORITY", "CLAIM_TYPE_OR_STRENGTH", "PREDICATE_ARGUMENT_STRUCTURE", "RHETORICAL_FUNCTION", "ACTOR_OR_TARGET", "TIME", "NEGATION", "CAUSAL_RELATION", "TERMINOLOGY", "UNCERTAIN"] }
  }
}
